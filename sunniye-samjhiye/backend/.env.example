# ===================================================================
# Sunniye, Samjhiye Backend Environment Configuration
# ===================================================================

# Sarvam AI API Credentials
# Obtain an API key from https://dashboard.sarvam.ai/
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_BASE_URL=https://api.sarvam.ai

# Models
SARVAM_STT_MODEL=saaras:v4
SARVAM_LLM_MODEL=sarvam-105b
SARVAM_TTS_MODEL=bulbul:v3

# Mode Configuration (set to true to force offline demo mode without calling APIs)
DEMO_MODE=false

# SQLite Database Location
DATABASE_URL=sqlite:///./sunniye_samjhiye.db

# Audio Privacy Settings
# When false, source audio files are not permanently stored on disk (ephemeral processing only)
STORE_AUDIO_FILES=false

